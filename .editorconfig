# Indentation follows XenForo's own code style, applied with xenforo-ltd/xf-cs-fixer
# (composer format). This file exists so an editor gets it right before the fixer runs.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,xml,neon,dist}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

{
	"name": "hampel/xenforo-test-framework",
	"type": "library",
	"description": "Unit testing framework for XenForo",
	"authors": [{
		"name": "Simon Hampel",
		"email": "simon@hampelgroup.com",
		"role": "Developer"
	}],
	"support": {
		"issues": "https://github.com/hampel/xenforo-test-framework/issues",
		"source": "https://github.com/hampel/xenforo-test-framework"
	},
	"keywords": [
		"xenforo",
		"phpunit",
		"unit testing",
		"testing"
	],
	"homepage": "https://xenforo.com/community/resources/unit-testing-xenforo-addons-tutorial.7508/",
	"license": "MIT",
	"require": {
		"php": ">=8.3.0",
		"phpunit/phpunit": "^10.0|^11.0|^12.0",
		"mockery/mockery": "^1.0"
	},
	"conflict": {
		"league/flysystem-memory": ">=2.0"
	},
    "suggest": {
        "nesbot/carbon": "Gives better control when dealing with time.",
		"league/flysystem-memory": "^1.0 - required when swapping out filesystems"
    },
	"require-dev": {
		"league/flysystem-memory": "^1.0",
		"nesbot/carbon": "^2.0|^3.0",
		"phpstan/phpstan": "^2.1.22"
	},
	"autoload-dev": {
		"psr-4": {
			"Hampel\\Testing\\Integration\\": "integration/"
		}
	},
	"config": {
		"sort-packages": true
	},
	"scripts": {
		"analyse": "XF_ROOT=${XF_ROOT:?set XF_ROOT to your XenForo root, eg XF_ROOT=/srv/www/myforum} phpstan analyse",
		"integration": "phpunit -c integration/phpunit.xml"
	},
	"autoload": {
		"psr-4": {
			"Hampel\\Testing\\": "src/"
		}
	}
}

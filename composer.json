{
	"name": "hampel/xenforo-test-framework",
	"type": "library",
	"description": "Unit testing framework for XenForo",
	"authors": [
		{
			"name": "Simon Hampel",
			"email": "simon@hampelgroup.com",
			"role": "Developer"
		}
	],
	"support": {
		"issues": "https://github.com/hampel/xenforo-test-framework/issues",
		"source": "https://github.com/hampel/xenforo-test-framework"
	},
	"keywords": [
		"xenforo",
		"phpunit",
		"unit testing",
		"testing"
	],
	"homepage": "https://xenforo.com/community/resources/unit-testing-xenforo-addons-tutorial.7508/",
	"license": "MIT",
	"require": {
		"php": ">=8.3.0",
		"phpunit/phpunit": "^10.5|^11.0|^12.0",
		"mockery/mockery": "^1.6"
	},
	"conflict": {
		"league/flysystem-memory": ">=2.0"
	},
	"suggest": {
		"nesbot/carbon": "Gives better control when dealing with time.",
		"league/flysystem-memory": "^1.0 - required when swapping out filesystems"
	},
	"require-dev": {
		"league/flysystem": "^1.1.4",
		"league/flysystem-memory": "^1.0",
		"nesbot/carbon": "^2.50|^3.0",
		"phpstan/phpstan": "^2.1.22",
		"phpstan/phpstan-mockery": "^2.0",
		"xenforo-ltd/xf-cs-fixer": "^1.2"
	},
	"autoload-dev": {
		"psr-4": {
			"Hampel\\Testing\\Integration\\": "integration/"
		}
	},
	"config": {
		"sort-packages": true,
		"policy": {
			"advisories": {
				"ignore-id": {
					"PKSA-w9tt-7782-78jx": "CVE-2026-102601 affects every flysystem release up to 3.35.2. XenForo supplies flysystem 1.x, which has no patched release and will not get one, and this is a dev-only dependency used by the test suite's in-memory filesystem"
				}
			}
		}
	},
	"scripts": {
		"check": [
			"@format:check",
			"@analyse",
			"@integration"
		],
		"analyse": "XF_ROOT=${XF_ROOT:?set XF_ROOT to your XenForo root, eg XF_ROOT=/srv/www/myforum} phpstan analyse",
		"integration": "phpunit -c integration/phpunit.xml",
		"check:lowest": "bash bin/check-lowest",
		"format": "php-cs-fixer fix",
		"format:check": "php-cs-fixer fix --dry-run --diff"
	},
	"autoload": {
		"psr-4": {
			"Hampel\\Testing\\": "src/"
		}
	}
}

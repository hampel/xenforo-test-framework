#!/usr/bin/env php
<?php

/**
 * Convert a Keep-a-Changelog-ish CHANGELOG.md to XenForo BBCode, for pasting into a resource
 * update post on xenforo.com.
 *
 * Prints to stdout by design. It is NOT meant to write a CHANGELOG.bbcode.txt beside the source:
 * a generated file on disk goes stale the moment the changelog is edited, and silently overwrites
 * whatever you tuned by hand last time. Reading the source at the moment you need it cannot do
 * either.
 *
 *   php bin/changelog-bbcode CHANGELOG.md              # the whole file
 *   php bin/changelog-bbcode CHANGELOG.md 3.0.1        # 3.0.1 and everything newer
 *   php bin/changelog-bbcode ../other/CHANGELOG.md 2.0 # any file, any project
 *
 * It converts only what the source marks up. Backtick your identifiers in CHANGELOG.md -
 * `fakesMail()`, `TypeError`, `enableMailQueue` - and they come out as [ICODE]. Leave them bare
 * and they stay bare, which is the difference between a post that reads like documentation and
 * one that reads like an email.
 */

const USAGE = <<<'TXT'
Usage: changelog-bbcode <CHANGELOG.md> [from-version]

  <CHANGELOG.md>   path to the changelog to convert
  [from-version]   optional: emit this version and every newer one, eg 3.0.1

TXT;

$path = $argv[1] ?? null;
$from = $argv[2] ?? null;

if ($path === null || in_array($path, ['-h', '--help'], true))
{
	fwrite(STDERR, USAGE);
	exit($path === null ? 1 : 0);
}

if (!is_file($path))
{
	fwrite(STDERR, "changelog-bbcode: no such file: $path\n");
	exit(1);
}

$markdown = file_get_contents($path);

if ($from !== null)
{
	$markdown = sliceFromVersion($markdown, $from);

	if (trim($markdown) === '')
	{
		fwrite(STDERR, "changelog-bbcode: no entries at or newer than $from in $path\n");
		exit(1);
	}
}

echo convert($markdown);

/**
 * Keep the entries for $from and everything above it, dropping the file header and older releases.
 *
 * Versions are compared with version_compare rather than as strings, so 3.0.10 sorts after 3.0.9.
 * An entry whose heading is not a version - "Unreleased", say - is kept when it appears above the
 * first matching release, since it is newer by position.
 */
function sliceFromVersion(string $markdown, string $from): string
{
	$lines = explode("\n", $markdown);
	$kept = [];
	$keeping = false;

	foreach ($lines as $i => $line)
	{
		if (isSetextHeading($lines, $i))
		{
			$version = versionOf($line);

			if ($version === null)
			{
				// a non-version heading: keep it only once we are already emitting
				$keeping = $keeping || false;
			}
			else
			{
				$keeping = version_compare($version, $from, '>=');
			}
		}

		if ($keeping)
		{
			$kept[] = $line;
		}
	}

	return implode("\n", $kept);
}

function isSetextHeading(array $lines, int $i): bool
{
	return isset($lines[$i + 1])
		&& trim($lines[$i]) !== ''
		&& preg_match('/^-{3,}$/', $lines[$i + 1]) === 1;
}

function versionOf(string $heading): ?string
{
	return preg_match('/^(\d+\.\d+(?:\.\d+)?)/', trim($heading), $m) ? $m[1] : null;
}

function convert(string $markdown): string
{
	$lines = explode("\n", $markdown);
	$out = [];
	$inList = false;
	$inCode = false;
	$count = count($lines);

	for ($i = 0; $i < $count; $i++)
	{
		$line = $lines[$i];

		// fenced code blocks pass through untouched - no inline conversion inside them
		if (str_starts_with($line, '```'))
		{
			if (!$inCode)
			{
				$lang = trim(substr($line, 3));
				$out[] = $lang !== '' ? "[CODE=$lang]" : '[CODE]';
				$inCode = true;
			}
			else
			{
				$out[] = '[/CODE]';
				$inCode = false;
			}
			continue;
		}

		if ($inCode)
		{
			$out[] = $line;
			continue;
		}

		// the file's own title, underlined with ===
		if (isset($lines[$i + 1]) && preg_match('/^={3,}$/', $lines[$i + 1]) === 1)
		{
			$i++;
			continue;
		}

		// a release heading, underlined with ---
		if (isSetextHeading($lines, $i))
		{
			if ($inList)
			{
				$out[] = '[/LIST]';
				$inList = false;
			}
			$out[] = '[HEADING=2]' . inlineMarkup(trim($line)) . '[/HEADING]';
			$i++;
			continue;
		}

		// ATX headings, in case a changelog uses them instead
		if (preg_match('/^(#{1,4})\s+(.*)$/', $line, $m) === 1)
		{
			if ($inList)
			{
				$out[] = '[/LIST]';
				$inList = false;
			}
			$level = min(3, max(1, strlen($m[1]) - 1));
			$out[] = "[HEADING=$level]" . inlineMarkup(trim($m[2])) . '[/HEADING]';
			continue;
		}

		// list items, with their wrapped continuation lines folded back in
		if (preg_match('/^[*-]\s+(.*)$/', $line, $m) === 1)
		{
			if (!$inList)
			{
				$out[] = '[LIST]';
				$inList = true;
			}

			$item = $m[1];
			while ($i + 1 < $count
				&& preg_match('/^\s{2,}\S/', $lines[$i + 1]) === 1
				&& !str_starts_with(ltrim($lines[$i + 1]), '```'))
			{
				$item .= ' ' . trim($lines[$i + 1]);
				$i++;
			}

			$out[] = '[*]' . inlineMarkup(labelBold($item));
			continue;
		}

		if ($inList && trim($line) === '')
		{
			$out[] = '[/LIST]';
			$out[] = '';
			$inList = false;
			continue;
		}

		$out[] = inlineMarkup($line);
	}

	if ($inCode)
	{
		$out[] = '[/CODE]';
	}

	if ($inList)
	{
		$out[] = '[/LIST]';
	}

	return rtrim(implode("\n", $out)) . "\n";
}

/**
 * Bold a leading "bugfix:" / "docs:" style label, which is the convention these changelogs use to
 * classify an entry and is worth picking out visually in a forum post.
 */
function labelBold(string $item): string
{
	return preg_replace('/^(bugfix|fix|docs|new|breaking|security|deprecated|removed):\s/i', '**$1:** ', $item, 1);
}

function inlineMarkup(string $text): string
{
	// code spans first, so emphasis inside them is left alone
	$spans = [];
	$text = preg_replace_callback('/`([^`]+)`/', function ($m) use (&$spans)
	{
		$spans[] = $m[1];
		return "\x00" . (count($spans) - 1) . "\x00";
	}, $text);

	$text = preg_replace('/\*\*([^*]+)\*\*/', '[B]$1[/B]', $text);
	$text = preg_replace('/(?<![\w*])\*([^*\s][^*]*)\*(?![\w*])/', '[I]$1[/I]', $text);
	$text = preg_replace('/\[([^\]]+)\]\(([^)]+)\)/', "[URL='$2']$1[/URL]", $text);

	return preg_replace_callback('/\x00(\d+)\x00/', function ($m) use ($spans)
	{
		return '[ICODE]' . $spans[(int) $m[1]] . '[/ICODE]';
	}, $text);
}

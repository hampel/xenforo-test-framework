<?xml version="1.0" encoding="UTF-8"?>
<!--
  This package's own integration tests. They boot a real XenForo application, so they need
  a forum and skip every test without one.

  They do not run in PUBLIC CI, because XenForo is licensed and no public workflow can
  fetch it - a licensing constraint rather than a technical one, and a workflow holding
  license credentials could provision a forum. See CLAUDE.md.

  The schema is 10.5, the oldest PHPUnit this package supports, so the config is validated
  against the end of the range most likely to reject an attribute.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         backupGlobals="false"
         backupStaticProperties="false"
         bootstrap="../vendor/autoload.php"
         cacheDirectory="../.phpunit.cache"
         colors="true"
         failOnDeprecation="true"
         failOnRisky="true"
         failOnNotice="true"
         failOnWarning="true"
         failOnPhpunitDeprecation="true"
         failOnEmptyTestSuite="true">
  <testsuites>
    <testsuite name="Integration">
      <directory suffix="Test.php">.</directory>
    </testsuite>
  </testsuites>
</phpunit>
